<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing goes to Google's cloud backup, and nothing
     is copied to a new phone by device transfer. Health data never leaves
     the phone except in a backup file the person makes and shares
     (safety charter rule 3; docs/android/DECISIONS.md). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
